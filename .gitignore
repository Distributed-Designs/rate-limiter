# ##########################################
# Go Compiled Binaries & Packages
# ##########################################
# Architecture-specific patterns or compiled artifacts
*.o
*.a
*.so
*.dylib

# Compiled local binaries / executables
*.exe
*.exe~
*.dll
app-bin/
bin/

# ##########################################
# Test & Coverage Artifacts
# ##########################################
# Test binaries generated by 'go test -c'
*.test

# Output files from benchmark/profiling tools
*.prof
*.out
*.coverprofile
profile.cov

# ##########################################
# Go Workspace & Dependency Management
# ##########################################
# Multi-module workspace files (usually kept local to your machine)
go.work
go.work.sum

# Vendor directory
# Uncomment the line below if you choose NOT to vendor dependencies
# and rely purely on the local module cache.
# vendor/

# ##########################################
# Environment & Secret Files
# ##########################################
# Never commit credentials or local configuration profiles
.env
*.env
.env.local

# ##########################################
# IDEs, Editors & OS Files
# ##########################################
# JetBrains (GoLand, IntelliJ)
.idea/
*.iml

# Visual Studio Code
.vscode/

# Operating System files
.DS_Store
Thumbs.db
